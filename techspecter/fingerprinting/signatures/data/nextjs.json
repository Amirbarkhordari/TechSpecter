{
  "id": "nextjs",
  "name": "Next.js",
  "category": "meta-framework",
  "priority": 110,
  "minimum_score": 50.0,
  "dependencies": ["react"],
  "conflicts_with": [],
  "required_rules": [
    {
      "id": "next-required",
      "matcher": "regex",
      "pattern": "__next_data__|/_next/static/|next/dist|buildmanifest",
      "target": "content",
      "weight": 1.0,
      "description": "Next.js runtime marker"
    }
  ],
  "positive_rules": [
    {
      "id": "next-data",
      "matcher": "contains",
      "pattern": "__next_data__",
      "target": "runtime",
      "weight": 95.0,
      "description": "Next.js __NEXT_DATA__ runtime"
    },
    {
      "id": "next-static",
      "matcher": "contains",
      "pattern": "/_next/static/",
      "target": "content",
      "weight": 85.0,
      "description": "Next.js static asset path"
    },
    {
      "id": "next-manifest",
      "matcher": "contains",
      "pattern": "buildmanifest",
      "target": "manifest",
      "weight": 90.0,
      "description": "Next.js build manifest"
    }
  ],
  "optional_rules": [],
  "negative_rules": [],
  "version_extractors": [
    {
      "id": "next-version",
      "pattern": "next[^0-9]*([0-9]+\\.[0-9]+\\.[0-9]+)",
      "source": "banner",
      "weight": 85.0,
      "enabled": true
    }
  ]
}
