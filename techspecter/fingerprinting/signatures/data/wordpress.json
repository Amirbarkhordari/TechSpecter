{
  "id": "wordpress",
  "name": "WordPress",
  "category": "cms",
  "priority": 90,
  "minimum_score": 45.0,
  "required_rules": [
    {
      "id": "wp-required",
      "matcher": "regex",
      "pattern": "wp-content|wp-includes|x-powered-by.*wordpress|generator.*wordpress",
      "target": "content",
      "weight": 1.0
    }
  ],
  "positive_rules": [
    {
      "id": "wp-header",
      "matcher": "contains",
      "pattern": "wordpress",
      "target": "header",
      "weight": 90.0
    },
    {
      "id": "wp-generator",
      "matcher": "contains",
      "pattern": "wordpress",
      "target": "metadata",
      "weight": 85.0
    },
    {
      "id": "wp-path",
      "matcher": "contains",
      "pattern": "wp-content",
      "target": "content",
      "weight": 80.0
    }
  ],
  "optional_rules": [],
  "negative_rules": [],
  "version_extractors": [
    {
      "id": "wp-version",
      "pattern": "wordpress[^0-9]*([0-9]+\\.[0-9]+(?:\\.[0-9]+)?)",
      "source": "metadata",
      "weight": 90.0,
      "enabled": true
    }
  ]
}
